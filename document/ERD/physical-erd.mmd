erDiagram
    %% ===== RELATIONSHIPS =====
    roles                ||--o{ users                : "fk_users_role"
    users                ||--o{ course_lecturers     : "fk_course_lecturers_user"
    courses              ||--o{ course_lecturers     : "fk_course_lecturers_course"
    courses              ||--|| rubrics              : "fk_rubrics_course"
    users                ||--o{ rubrics              : "fk_rubrics_creator"
    rubrics              ||--o{ rubric_criteria      : "fk_rubric_criteria_rubric"
    courses              ||--o{ chapters             : "fk_chapters_course"
    chapters             ||--o{ materials            : "fk_materials_chapter"
    users                ||--o{ materials            : "fk_materials_uploader"
    chapters             ||--o{ questions            : "fk_questions_chapter"
    users                ||--o{ questions            : "fk_questions_creator"
    courses              ||--o{ viva_exams           : "fk_viva_exams_course"
    users                ||--o{ viva_exams           : "fk_viva_exams_lecturer"
    viva_exams           ||--o{ viva_exam_questions  : "fk_viva_exam_questions_exam"
    questions            ||--o{ viva_exam_questions  : "fk_viva_exam_questions_question"
    viva_exams           ||--o{ viva_attempts        : "fk_viva_attempts_exam"
    users                ||--o{ viva_attempts        : "fk_viva_attempts_student"
    viva_attempts        ||--o{ interview_exchanges  : "fk_interview_exchanges_attempt"
    viva_exam_questions  ||--o{ interview_exchanges  : "fk_interview_exchanges_question"
    interview_exchanges  |o--o| interview_exchanges  : "fk_interview_exchanges_parent"
    viva_attempts        ||--o{ question_grades      : "fk_question_grades_attempt"
    viva_exam_questions  ||--o{ question_grades      : "fk_question_grades_question"
    users                |o--o{ question_grades      : "fk_question_grades_grader"
    question_grades      ||--o{ criteria_grades      : "fk_criteria_grades_question_grade"
    rubric_criteria      ||--o{ criteria_grades      : "fk_criteria_grades_criteria"
    question_grades      ||--o{ grade_appeals        : "fk_grade_appeals_question_grade"
    users                |o--o{ grade_appeals        : "fk_grade_appeals_resolver"

    %% ===== BẢNG NGHIỆP VỤ =====
    roles {
        VARCHAR(20)     roles_id        PK
        VARCHAR(20)     name            UK
        VARCHAR(255)    description
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    users {
        VARCHAR(20)     users_id        PK
        VARCHAR(20)     roles_id        FK
        VARCHAR(255)    email           UK
        VARCHAR(255)    password_hash
        VARCHAR(150)    full_name
        BOOLEAN         is_active
        BOOLEAN         must_change_password
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    courses {
        VARCHAR(20)     courses_id      PK
        VARCHAR(50)     course_code     UK
        VARCHAR(200)    name
        TEXT            description
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    course_lecturers {
        VARCHAR(20)     course_lecturers_id PK
        VARCHAR(20)     courses_id          FK
        VARCHAR(20)     users_id            FK
        TIMESTAMP       created_at
    }
    chapters {
        VARCHAR(20)     chapters_id     PK
        VARCHAR(20)     courses_id      FK
        VARCHAR(200)    name
        INTEGER         order_no
        TEXT            description
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    materials {
        VARCHAR(20)     materials_id    PK
        VARCHAR(20)     chapters_id     FK
        VARCHAR(20)     uploaded_by     FK
        VARCHAR(200)    title
        VARCHAR(500)    file_url
        VARCHAR(20)     file_type
        INTEGER         file_size
        VARCHAR(20)     rag_status
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    rubrics {
        VARCHAR(20)     rubrics_id      PK
        VARCHAR(20)     courses_id      FK, UK
        VARCHAR(20)     created_by      FK
        VARCHAR(200)    name
        TEXT            description
        NUMERIC         max_score
        BOOLEAN         is_locked
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    rubric_criteria {
        VARCHAR(20)     rubric_criteria_id  PK
        VARCHAR(20)     rubrics_id          FK
        VARCHAR(200)    name
        TEXT            description
        NUMERIC         weight_percent
        INTEGER         order_no
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    questions {
        VARCHAR(20)     questions_id        PK
        VARCHAR(20)     chapters_id         FK
        VARCHAR(20)     created_by          FK
        TEXT            content
        VARCHAR(20)     difficulty
        TEXT            model_answer
        TEXT            expected_keywords
        VARCHAR(20)     source
        VARCHAR(20)     status
        VARCHAR(500)    question_audio_key
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    viva_exams {
        VARCHAR(30)     viva_exams_id               PK
        VARCHAR(20)     courses_id                  FK
        VARCHAR(20)     lecturer_id                 FK
        VARCHAR(200)    title
        VARCHAR(2000)   description
        VARCHAR(6)      passcode
        INTEGER         duration_minutes
        INTEGER         max_attempts
        INTEGER         max_follow_up_per_question
        INTEGER         prepare_seconds
        INTEGER         answer_seconds
        TEXT            domain_keywords
        INTEGER         question_count
        TIMESTAMP       start_at
        TIMESTAMP       end_at
        TIMESTAMP       cancelled_at
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    viva_exam_questions {
        VARCHAR(20)     viva_exam_questions_id  PK
        VARCHAR(30)     viva_exams_id           FK, UK
        VARCHAR(20)     questions_id            FK, UK
        INTEGER         order_no                UK
        NUMERIC         weight
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    viva_attempts {
        VARCHAR(20)     viva_attempts_id    PK
        VARCHAR(30)     viva_exams_id       FK, UK
        VARCHAR(20)     student_id          FK, UK
        INTEGER         attempt_no          UK
        VARCHAR(20)     status
        VARCHAR(20)     result_status
        NUMERIC         total_ai_score
        NUMERIC         total_final_score
        VARCHAR(500)    full_audio_key
        TIMESTAMP       started_at
        TIMESTAMP       deadline_at
        TIMESTAMP       completed_at
        TIMESTAMP       published_at
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    interview_exchanges {
        VARCHAR(20)     interview_exchanges_id  PK
        VARCHAR(20)     viva_attempts_id        FK
        VARCHAR(20)     viva_exam_questions_id  FK
        VARCHAR(20)     parent_exchange_id      FK, UK
        INTEGER         depth
        TEXT            question_text
        VARCHAR(500)    question_audio_key
        TEXT            transcript
        VARCHAR(500)    answer_audio_key
        VARCHAR(20)     follow_up_reason
        VARCHAR(20)     ai_decision
        TEXT            ai_decision_reason
        TIMESTAMP       answer_started_at
        TIMESTAMP       answer_ended_at
        INTEGER         latency_ms
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    question_grades {
        VARCHAR(20)     question_grades_id      PK
        VARCHAR(20)     viva_attempts_id        FK, UK
        VARCHAR(20)     viva_exam_questions_id  FK, UK
        NUMERIC         ai_score
        NUMERIC         final_score
        TEXT            ai_strengths
        TEXT            ai_weaknesses
        TEXT            ai_feedback
        TEXT            lecturer_note
        VARCHAR(20)     status
        VARCHAR(20)     graded_by               FK
        TIMESTAMP       graded_at
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    criteria_grades {
        VARCHAR(20)     criteria_grades_id  PK
        VARCHAR(20)     question_grades_id  FK, UK
        VARCHAR(20)     rubric_criteria_id  FK, UK
        NUMERIC         ai_score
        NUMERIC         final_score
        TEXT            evidence_quote
        TEXT            rationale
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
    grade_appeals {
        VARCHAR(20)     grade_appeals_id    PK
        VARCHAR(20)     question_grades_id  FK
        TEXT            reason
        VARCHAR(20)     status
        NUMERIC         score_before
        NUMERIC         score_after
        TEXT            response
        VARCHAR(20)     resolved_by         FK
        TIMESTAMP       resolved_at
        TIMESTAMP       created_at
        TIMESTAMP       updated_at
    }
