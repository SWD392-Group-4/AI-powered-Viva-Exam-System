erDiagram
    %% ===== RELATIONSHIPS =====
    LECTURER            }|--|{ COURSE              : "Teaches"
    COURSE              ||--|| RUBRIC              : "Defines"
    RUBRIC              ||--|{ RUBRIC_CRITERIA     : "Consists of"
    COURSE              ||--|{ CHAPTER             : "Contains"
    CHAPTER             ||--|{ MATERIAL            : "Provides"
    CHAPTER             ||--|{ QUESTION            : "Contains"
    COURSE              ||--|{ VIVA_EXAM           : "Organizes"
    LECTURER            ||--|{ VIVA_EXAM           : "Creates"
    VIVA_EXAM           ||--|{ VIVA_EXAM_QUESTION  : "Includes"
    QUESTION            ||--|{ VIVA_EXAM_QUESTION  : "Selected in"
    VIVA_EXAM           ||--|{ VIVA_ATTEMPT        : "Taken in"
    STUDENT             ||--|{ VIVA_ATTEMPT        : "Takes"
    VIVA_ATTEMPT        ||--|{ INTERVIEW_EXCHANGE  : "Records"
    VIVA_EXAM_QUESTION  ||--|{ INTERVIEW_EXCHANGE  : "Asked in"
    INTERVIEW_EXCHANGE  |o--o| INTERVIEW_EXCHANGE  : "Follows up"
    VIVA_ATTEMPT        ||--|{ QUESTION_GRADE      : "Receives"
    VIVA_EXAM_QUESTION  ||--|{ QUESTION_GRADE      : "Graded for"
    LECTURER            |o--|{ QUESTION_GRADE      : "Finalizes"
    QUESTION_GRADE      ||--|{ CRITERIA_GRADE      : "Broken into"
    RUBRIC_CRITERIA     ||--|{ CRITERIA_GRADE      : "Applied in"
    QUESTION_GRADE      ||--o{ GRADE_APPEAL        : "Appealed by"
    LECTURER            |o--|{ GRADE_APPEAL        : "Resolves"

    %% ===== ENTITIES =====
    LECTURER {
        int      lecturer_id   PK
        string   email         UK
        string   password_hash
        string   full_name
        boolean  is_active
    }
    STUDENT {
        int      student_id    PK
        string   email         UK
        string   password_hash
        string   full_name
        boolean  is_active
    }
    COURSE {
        int      course_id     PK
        string   course_code   UK
        string   name
        text     description
    }
    CHAPTER {
        int      chapter_id    PK
        int      course_id     FK
        string   name
        int      order_no
        text     description
    }
    MATERIAL {
        int      material_id   PK
        int      chapter_id    FK
        int      uploaded_by   FK
        string   title
        string   file_url
        string   file_type
        int      file_size
        enum     rag_status    "INDEXING, READY, FAILED"
    }
    QUESTION {
        int      question_id       PK
        int      chapter_id        FK
        int      created_by        FK
        text     content
        enum     difficulty        "EASY, MEDIUM, HARD"
        text     model_answer
        text     expected_keywords
        enum     source            "MANUAL, AI_GENERATED"
        enum     status            "DRAFT, APPROVED, REJECTED, ARCHIVED"
    }
    RUBRIC {
        int      rubric_id     PK
        int      course_id     FK "UK: 1 môn học có 1 rubric duy nhất"
        string   name
        text     description
        decimal  max_score
        boolean  is_locked     "True khi môn học có ca thi OPEN/CLOSED"
    }
    RUBRIC_CRITERIA {
        int      criteria_id    PK
        int      rubric_id      FK
        string   name
        text     description
        decimal  weight_percent "Tổng = 100%"
        int      order_no
    }
    VIVA_EXAM {
        string   viva_exam_id               PK
        int      course_id                  FK
        int      lecturer_id                FK
        string   title
        text     description
        string   passcode
        int      duration_minutes
        int      max_follow_up_per_question
        int      prepare_seconds
        int      answer_seconds
        text     domain_keywords
        datetime start_at
        datetime end_at
        datetime cancelled_at
    }
    VIVA_EXAM_QUESTION {
        int      viva_exam_question_id PK
        string   viva_exam_id          FK
        int      question_id           FK
        int      order_no
        decimal  weight
    }
    VIVA_ATTEMPT {
        int      attempt_id        PK
        string   viva_exam_id      FK
        int      student_id        FK
        enum     status            "NOT_STARTED, IN_PROGRESS, COMPLETED, ABANDONED"
        enum     result_status     "NONE, GRADING, PENDING_REVIEW, GRADING_FAILED, PUBLISHED"
        decimal  total_ai_score
        decimal  total_final_score
        string   full_audio_key
        datetime started_at
        datetime deadline_at
        datetime completed_at
        datetime published_at
    }
    INTERVIEW_EXCHANGE {
        int      exchange_id           PK
        int      attempt_id            FK
        int      viva_exam_question_id FK
        int      parent_exchange_id    FK "NULL = câu gốc"
        int      depth
        text     question_text
        text     transcript
        enum     follow_up_reason      "INCOMPLETE, AMBIGUOUS, CONTRADICTORY"
        enum     ai_decision           "FOLLOW_UP, NEXT, SKIPPED"
        int      latency_ms
    }
    QUESTION_GRADE {
        int      question_grade_id     PK
        int      attempt_id            FK
        int      viva_exam_question_id FK
        int      graded_by             FK "Lecturer, NULL khi chưa chốt"
        decimal  ai_score
        decimal  final_score
        text     ai_feedback
        text     lecturer_note
        enum     status                "AI_DRAFT, APPROVED, FAILED"
        datetime graded_at
    }
    CRITERIA_GRADE {
        int      criteria_grade_id PK
        int      question_grade_id FK
        int      criteria_id       FK
        decimal  ai_score
        decimal  final_score
        text     evidence_quote
        text     rationale
    }
    GRADE_APPEAL {
        int      appeal_id         PK
        int      question_grade_id FK
        int      resolved_by       FK "Lecturer, NULL khi PENDING"
        text     reason
        enum     status            "PENDING, ACCEPTED, REJECTED"
        decimal  score_before
        decimal  score_after
        text     response
        datetime created_at
        datetime resolved_at
    }
